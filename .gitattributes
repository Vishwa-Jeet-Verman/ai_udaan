# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.dart text
*.js text
*.json text
*.md text
*.yaml text
*.yml text

# Scripts
*.sh text eol=lf

# Documentation
*.txt text
*.pdf binary

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.apk binary
*.aab binary
*.ipa binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Videos
*.mp4 binary
*.mov binary
*.avi binary

# Audio
*.mp3 binary
*.wav binary
*.ogg binary
