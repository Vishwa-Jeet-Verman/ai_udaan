# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=9000

# for prod mode
# NODE_ENV=production
# BASE_URL=https://your-production-domain.com
# CORS_ORIGIN=https://your-production-domain.com

# for dev mode
NODE_ENV=development
BASE_URL=http://10.0.2.2:9000
CORS_ORIGIN=*


# ========================================
# JWT AUTHENTICATION
# ========================================
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Currently using Moodle API only - no local database

# ========================================
# MOODLE INTEGRATION
# ========================================
MOODLE_URL=https://your-moodle-instance.com
MOODLE_TOKEN=your-moodle-webservice-token
MOODLE_COURSE_TOKEN=your-course-management-token
MOODLE_CREATE_USER_TOKEN=your-user-creation-token
MOODLE_ENROL_TOKEN=your-enrollment-token
MOODLE_SERVICE_NAME=moodle_mobile_app
MOODLE_ADMIN_ID=2

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100

# ========================================
# S3 CONFIGURATION (Optional - currently not in use)
# ========================================
# S3_REGION=auto
# S3_ENDPOINT=https://your-s3-endpoint.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=your-bucket-name

# ========================================
# EMAIL / SMTP CONFIGURATION (OTP emails)
# ========================================
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@example.com
APP_NAME=AI UDAAN

# ========================================
# RAZORPAY CONFIGURATION (Payment Gateway)
# ========================================
# For testing, use test keys (rzp_test_xxx)
# For production, use live keys (rzp_live_xxx)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ========================================
# SECURITY REMINDERS
# ========================================
# 1. Never commit this .env file to version control
# 2. .env is already in .gitignore
# 3. For production, use strong secrets and HTTPS
# 4. Rotate all secrets regularly
# 5. Use different secrets for dev/staging/production
