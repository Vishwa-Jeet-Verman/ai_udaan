# ========================================
# ENVIRONMENT MODE
# "dev"  → connects to local backend
# "prod" → connects to production backend
# ========================================
 
# ========================================
# DEV — local backend
# ========================================
APP_ENV=dev
API_BASE_URL_ANDROID=http://10.0.2.2:9000/api
API_BASE_URL_LOCAL=http://localhost:9000/api
SOCKET_URL_ANDROID=http://10.0.2.2:9000
SOCKET_URL_LOCAL=http://localhost:9000

# ========================================
# PROD — Production backend
# ========================================
# Uncomment and configure for production
# APP_ENV=prod
# API_BASE_URL_PROD=https://your-production-api.com/api
# SOCKET_URL_PROD=https://your-production-api.com

# ========================================
# MOODLE
# ========================================
MOODLE_URL=https://your-moodle-instance.com

# ========================================
# RAZORPAY CONFIGURATION
# ========================================
# For testing, use test key (rzp_test_xxx)
# For production, use live key (rzp_live_xxx)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ========================================
# SECURITY REMINDERS
# ========================================
# 1. Never commit this .env file to version control
# 2. .env is already in .gitignore
# 3. Use test keys for development
# 4. Use live keys only in production
# 5. Keep this file secure and private
